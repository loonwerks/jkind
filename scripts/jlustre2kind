#!/bin/sh

# Follow symbolic links to find actual JKind directory
# By David Greve
# Adapted from http://stackoverflow.com/a/7400673/984145

rawpath() { [ ! -h "$1" ] && echo "$1" || (local link="$(expr "$(command ls -ld -- "$1")" : '.*-> \(.*\)$')"; cd $(dirname $1); rawpath "$link" | sed "s|^\([^/].*\)\$|$(dirname $1)/\1|"); }

linkdir() { cd $(dirname $(rawpath $1)); pwd -P; }

# Parsing and the AST visitors recurse on expression structure, and generated
# Lustre can nest very deeply, so the default stack is not always enough.
# Override by setting JKIND_JAVA_OPTS.
: ${JKIND_JAVA_OPTS:=-Xss32m}

JKIND_DIR=$(linkdir $0)
java $JKIND_JAVA_OPTS -jar $JKIND_DIR/jkind.jar -jlustre2kind "$@"
