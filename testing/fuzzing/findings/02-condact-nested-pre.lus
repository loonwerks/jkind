-- Finding 2: a nested pre inside a condact'd node crashes translation.
--
-- Expected: normal analysis.
-- Actual:   java.util.ConcurrentModificationException, exit -8.
node inner(x : int) returns (y : int);
let
  y = 0 -> pre (0 -> pre x);
tel;

node main(c : bool; x : int) returns ();
var
  ok : bool;
let
  ok = condact(c, inner(x), 0) >= 0;
  --%PROPERTY ok;
tel;
